# Copia para ".env.local" e preenche com os dados da App Registration
# no Azure AD (a mesma usada no backend). Ver README para o passo-a-passo.

VITE_AZURE_CLIENT_ID=coloca_aqui_o_client_id
VITE_AZURE_TENANT_ID=coloca_aqui_o_tenant_id
# Scope da API exposta pela App Registration (Expose an API > Add a scope)
VITE_API_SCOPE=api://coloca_aqui_o_client_id/access_as_user
# URI de redirect registado no Azure AD (plataforma "Single-page application")
VITE_REDIRECT_URI=http://localhost:5173

# Intervalo de auto-refresh por omissão (segundos)
VITE_DEFAULT_REFRESH_SECONDS=30
