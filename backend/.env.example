# ────────────────────────────────────────────────────────────
# Zammad Dashboard — Backend — variáveis de ambiente
# Copia este ficheiro para ".env" e preenche os valores reais.
# NUNCA fazer commit do ficheiro ".env" (ver .gitignore).
# ────────────────────────────────────────────────────────────

# --- Servidor -------------------------------------------------
PORT=4000
NODE_ENV=development
# Origem do frontend (dev: Vite; produção: normalmente não é preciso
# porque o Express serve o build estático a partir do mesmo domínio)
FRONTEND_ORIGIN=http://localhost:4080

# --- Zammad -----------------------------------------------------
ZAMMAD_URL=https://zammad.exemplo.com
# Token de API gerado em Zammad > Perfil > Token de Acesso
ZAMMAD_API_TOKEN=coloca_aqui_o_token_da_api_do_zammad

# --- Azure AD (App Registration) --------------------------------
# Tenant (Directory) ID
AZURE_TENANT_ID=coloca_aqui_o_tenant_id
# Application (client) ID da App Registration
AZURE_CLIENT_ID=coloca_aqui_o_client_id
# Opcional — só é preciso se validares access tokens de um scope de API
# customizado. O frontend usa o idToken (aud = AZURE_CLIENT_ID) por omissão,
# por isso normalmente não precisas de definir esta variável.
# AZURE_API_AUDIENCE=api://coloca_aqui_o_client_id

# --- Controlo de acesso (listas separadas por vírgulas) ---------
# Emails com acesso total (dashboard + separador Logs)
ALLOWED_ADMINS=admin1@empresa.com,admin2@empresa.com
# Emails com acesso apenas de leitura (sem separador Logs)
ALLOWED_VIEWERS=viewer1@empresa.com,viewer2@empresa.com

# --- Logs (docker logs) ----------------------------------
# Whitelist de nomes de containers permitidos (separados por vírgula).
# Usa os nomes REAIS dos teus containers — corre `docker ps --format
# '{{.Names}}'` no servidor para os veres (normalmente algo como
# <projeto>-<serviço>-1, gerado pelo docker compose v2).
# Nunca aceitar nomes de containers vindos de input livre do utilizador.
LOG_CONTAINERS=zammad-tickets-zammad-railsserver-1,zammad-tickets-zammad-nginx-1,zammad-tickets-zammad-scheduler-1

# Se este backend NÃO corre na mesma máquina que os containers do Zammad
# (ex: dashboard em dev no teu Windows, Zammad num servidor Linux à parte),
# `docker logs` não tem nenhum daemon local a que se ligar. Define DOCKER_HOST
# a apontar para o Docker do servidor via SSH — requer:
#   1. Chave SSH sem password do utilizador que corre o backend para o
#      servidor (testa primeiro: `ssh utilizador@servidor docker ps`).
#   2. Esse utilizador SSH tem de poder correr `docker` no servidor
#      (normalmente por pertencer ao grupo "docker").
# DOCKER_HOST=ssh://utilizador@ip-ou-hostname-do-servidor

# --- Cache (ms) ----------------------------------------------------
STATS_CACHE_TTL_MS=60000
LIST_CACHE_TTL_MS=300000

# --- Rate limiting ---------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
